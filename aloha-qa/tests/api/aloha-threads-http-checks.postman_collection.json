    {
      "name": "GET admin/orders гость: 302 на вход",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Гость: статус 302\", function () {\r\n    pm.response.to.have.status(302);\r\n});\r\n\r\npm.test(\"Гость: перенаправление на страницу входа\", function () {\r\n    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/login.php\");\r\n});\r\n\r\npm.test(\"Гость: данных админки в ответе нет\", function () {\r\n    pm.expect(pm.response.text()).to.not.include(\"Заказы\");\r\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://mysuperpetproject.ru/admin/orders.php?attempt=1",
          "protocol": "https",
          "host": [
            "mysuperpetproject",
            "ru"
          ],
          "path": [
            "admin",
            "orders.php"
          ],
          "query": [
            {
              "key": "attempt",
              "value": "1"
            }
          ]
        }
