  "item": [
    {
      "name": "GET главная: 200 и название магазина",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Ответ быстрее 2000 мс\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\npm.test(\"На главной есть название магазина\", function () {\r\n    pm.expect(pm.response.text()).to.include(\"Aloha\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://mysuperpetproject.ru/",
          "protocol": "https",
          "host": [
            "mysuperpetproject",
            "ru"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST cart_add без токена: 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Без токена: статус 403\", function () {\r\n    pm.response.to.have.status(403);\r\n});\r\n\r\npm.test(\"Без токена: показано сообщение об устаревшей сессии\", function () {\r\n    pm.expect(pm.response.text()).to.include(\"Сессия устарела\");\r\n});\r\n\r\npm.test(\"Без токена: нет перенаправления в корзину\", function () {\r\n    pm.expect(pm.response.headers.has(\"Location\")).to.be.false;\r\n});"
            ]
          }
        }
      ],
